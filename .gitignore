__pycache__/
*.pyc
.venv/
venv/
# local scratch: ad-hoc runs, injected-fault outputs, downloaded PDFs
_test/*
_test2*/
# ...but the replicable case suite and its checks are part of the deliverable:
# the scripts and the expected answers are small, the PDFs are regenerated by
# make_cases.py
!_test/cases/
!_test/test_*.py
_test/cases/_out/
_test/cases/_matrix/
_test/cases/_base_vs_skill/
_test/cases/_build_*
_test/cases/*/paper.pdf
_test/cases/report.json
_test/cases/matrix.json
out/
output/
*.log
!docs/*.md
bench/pdfs/*.pdf
# the independent evaluation: scripts, the official briefs, the pinned commit
# and report.md are the deliverable.  Cases are regenerated by make_cases.py,
# runs and the Skills snapshot are rebuilt by run_eval.py, and the per-run JSON
# embeds absolute paths, so none of those belong in history.
_eval/cases/
_eval/runs*/
_eval/pinned/skills/
_eval/*.json
_eval30_current/
.workbuddy/
_research/
challenges/
# raw session exports are large and contain prompt text; the derived trace is
# shipped instead, and only the round that is documented in docs/usage.md
trace/*
!trace/README.md
!trace/round2-steps.jsonl
*.zip
